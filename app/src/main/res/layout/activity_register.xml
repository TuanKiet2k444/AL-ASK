<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/auth_surface"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="32dp"
        android:paddingVertical="40dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_auth_brand_icon"
                android:padding="8dp"
                android:src="@drawable/ic_sparkles" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AI STUDY MENTOR"
                    android:textColor="@color/toty_gold"
                    android:textSize="14sp"
                    android:fontFamily="sans-serif-condensed-light"
                    android:letterSpacing="0.1"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ELITE LEARNING"
                    android:textColor="@color/auth_muted_foreground"
                    android:textSize="10sp"
                    android:letterSpacing="0.05" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="48dp"
            android:text="@string/auth_register_title"
            android:textColor="@color/auth_foreground"
            android:textSize="26sp"
            android:fontFamily="sans-serif-black"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/auth_register_subtitle"
            android:textColor="@color/auth_muted_foreground"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="@string/auth_fullname_label"
            android:textColor="@color/toty_cyan"
            android:textSize="10sp"
            android:letterSpacing="0.1"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/edit_fullname"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_auth_input"
            android:hint="Full Name"
            android:inputType="textPersonName"
            android:paddingHorizontal="16dp"
            android:textColor="@color/auth_foreground"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/auth_email_label"
            android:textColor="@color/toty_cyan"
            android:textSize="10sp"
            android:letterSpacing="0.1"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/edit_email"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_auth_input"
            android:hint="candidate@elite.edu"
            android:inputType="textEmailAddress"
            android:paddingHorizontal="16dp"
            android:textColor="@color/auth_foreground"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/auth_password_label"
            android:textColor="@color/toty_cyan"
            android:textSize="10sp"
            android:letterSpacing="0.1"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/edit_password"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_auth_input"
            android:hint="@string/auth_password_hint"
            android:inputType="textPassword"
            android:paddingHorizontal="16dp"
            android:textColor="@color/auth_foreground"
            android:textSize="14sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_register"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="32dp"
            android:text="@string/auth_register_btn"
            android:textAllCaps="true"
            android:textColor="@color/black"
            app:backgroundTint="@null"
            android:background="@drawable/btn_toty_gold"
            app:cornerRadius="26dp" />

        <TextView
            android:id="@+id/tv_go_to_login"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="24dp"
            android:text="@string/auth_have_account"
            android:textColor="@color/toty_gold"
            android:textSize="13sp" />

    </LinearLayout>
</ScrollView>